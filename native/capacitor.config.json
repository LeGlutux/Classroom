{
  "appId": "org.thotnote.app",
  "appName": "Thòt Note",
  "webDir": "../build",
  "server": {
    "url": "https://thotnote.org",
    "androidScheme": "https",
    "allowNavigation": [
      "thotnote.org",
      "www.thotnote.org",
      "*.thotnote.org",
      "*.firebaseapp.com",
      "*.googleapis.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#0F3A2A",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#f4f4f5"
    },
    "Keyboard": {
      "resize": "none"
    }
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "scheme": "ThotNote"
  }
}
